---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const i = t(locale);
const f = i.contact.form;
---

<section class="section section-alt" id="contact">
  <div class="container">
    <div class="section-label reveal">{i.contact.label}</div>
    <div class="section-title reveal">{i.contact.title_1}<br/>{i.contact.title_2}</div>
    <div class="section-desc reveal">{i.contact.desc}</div>

    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="contact-item">
          <div class="contact-icon">📧</div>
          <div>
            <strong>Email</strong>
            <span><a href="mailto:info@stoaconsultancy.com">info@stoaconsultancy.com</a></span>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon">📱</div>
          <div>
            <strong>WhatsApp</strong>
            <span><a href="tel:+39000000000">+39 000 000 0000</a></span>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon">📍</div>
          <div>
            <strong>{i.contact.offices}</strong>
            <span>Milano, Italia — Istanbul, Türkiye</span>
          </div>
        </div>
        <div class="contact-item">
          <div class="contact-icon">🕐</div>
          <div>
            <strong>{i.contact.hours}</strong>
            <span>{i.contact.hours_value}</span>
          </div>
        </div>
      </div>

      <div class="contact-form reveal">
        <form id="contactForm" data-success={f.success}>
          <div class="form-row">
            <div class="form-group">
              <label>{f.name}</label>
              <input type="text" name="name" required />
            </div>
            <div class="form-group">
              <label>{f.email}</label>
              <input type="email" name="email" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>{f.nationality}</label>
              <select name="nationality">
                <option value="">{f.nationality_select}</option>
                <option value="it">{f.nationality_it}</option>
                <option value="tr">{f.nationality_tr}</option>
                <option value="other">{f.nationality_other}</option>
              </select>
            </div>
            <div class="form-group">
              <label>{f.service}</label>
              <select name="service">
                <option value="">{f.service_select}</option>
                <option value="visa">{f.service_visa}</option>
                <option value="property">{f.service_property}</option>
                <option value="education">{f.service_education}</option>
                <option value="business">{f.service_business}</option>
                <option value="concierge">{f.service_concierge}</option>
                <option value="golden">{f.service_golden}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>{f.message}</label>
            <textarea name="message" placeholder={f.message_placeholder}></textarea>
          </div>
          <button type="submit" class="btn btn-primary form-submit">{f.submit}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const msg = form.dataset.success || 'Thank you!';
    alert(msg);
    form.reset();
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .contact-info { padding-top: 8px; }
  .contact-item {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
  }
  .contact-icon {
    width: 44px; height: 44px;
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
    color: var(--gold);
  }
  .contact-item strong {
    display: block;
    font-size: .82rem;
    color: var(--white);
    margin-bottom: 2px;
    letter-spacing: .02em;
  }
  .contact-item span { font-size: .88rem; color: var(--text-dim); }
  .contact-item a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color .3s;
  }
  .contact-item a:hover { color: var(--gold-light); }
  .contact-form {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 44px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .form-group { margin-bottom: 16px; }
  .form-group label {
    display: block;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 14px 16px;
    color: var(--text);
    font-family: var(--sans);
    font-size: .88rem;
    transition: border-color .3s;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: var(--gold); }
  .form-group textarea { resize: vertical; min-height: 100px; }
  .form-group select { cursor: pointer; }
  .form-group select option { background: var(--bg-card); }
  .form-submit { width: 100%; margin-top: 8px; }

  @media (max-width: 1024px) { .contact-grid { grid-template-columns: 1fr; gap: 48px; } }
  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-form { padding: 28px; }
  }
</style>
